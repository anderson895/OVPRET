rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────
    function isAuthenticated() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function getUserRole() { return userDoc().role; }
    function isAdmin() { return isAuthenticated() && getUserRole() == 'admin'; }
    function isVP()    { return isAuthenticated() && getUserRole() == 'vp'; }
    function isStaff() { return isAuthenticated() && getUserRole() == 'staff'; }
    function isActive() { return userDoc().isActive == true; }

    // ── Users collection ────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ── Documents collection ────────────────────────────────
    match /documents/{docId} {

      // READ
      allow get: if isAdmin() ||
        (isAuthenticated() && isActive() && isVP()) ||
        (isAuthenticated() && isActive() && isStaff() &&
          resource.data.submittedByUid == request.auth.uid);

      allow list: if isAdmin() ||
        (isAuthenticated() && isActive() && isVP()) ||
        (isAuthenticated() && isActive() && isStaff());

      // CREATE
      allow create: if isAuthenticated() && isActive() &&
        (isStaff() || isAdmin()) &&
        request.resource.data.submittedByUid == request.auth.uid;

      // UPDATE (UPDATED ✅)
      allow update: if isAuthenticated() && isActive() &&
        (
          isAdmin() ||
          isVP() ||
          (
            isStaff() &&
            resource.data.submittedByUid == request.auth.uid && // own doc only
            request.resource.data.submittedByUid == resource.data.submittedByUid // cannot change owner
          )
        );

      // DELETE
      allow delete: if isAdmin();
    }

    // ── Logs (append-only) ──────────────────────────────────
    match /logs/{logId} {
      allow read:   if isAdmin() || (isAuthenticated() && isActive() && isVP());
      allow create: if isAuthenticated() && isActive();
      allow update, delete: if false;
    }
  }
}