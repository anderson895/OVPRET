rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────
    function isAuthenticated() { return request.auth != null; }
    function userDoc()         { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function getUserRole()     { return userDoc().role; }
    function isAdmin()  { return isAuthenticated() && getUserRole() == 'admin'; }
    function isVP()     { return isAuthenticated() && getUserRole() == 'vp'; }
    function isStaff()  { return isAuthenticated() && getUserRole() == 'staff'; }
    function isActive() { return isAuthenticated() && userDoc().isActive == true; }

    // ── Users collection ────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // FIX: Allow self-registration.
      // When a user registers, they are signed in to the primary app (so request.auth is
      // not null), but they have no admin role yet.  We permit the create only if:
      //   • the document UID matches the authenticated user
      //   • role is locked to 'staff'
      //   • account starts inactive and pending (requires admin approval)
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'staff' &&
        request.resource.data.isActive == false &&
        request.resource.data.status == 'pending'
      );

      // FIX: self-update requires active account; admin can always update
      allow update: if isAdmin() || (request.auth.uid == userId && isActive());
      allow delete: if isAdmin();
    }

    // ── Documents collection ────────────────────────────────
    match /documents/{docId} {

      // READ
      allow get: if isAdmin() ||
        (isActive() && isVP()) ||
        (isActive() && isStaff() &&
          resource.data.submittedByUid == request.auth.uid);

      allow list: if isAdmin() ||
        (isActive() && isVP()) ||
        (isActive() && isStaff());

      // CREATE
      allow create: if isAuthenticated() && isActive() &&
        (isStaff() || isAdmin()) &&
        request.resource.data.submittedByUid == request.auth.uid;

      // UPDATE
      allow update: if isAuthenticated() && isActive() &&
        (
          isAdmin() ||
          isVP() ||
          (
            isStaff() &&
            resource.data.submittedByUid == request.auth.uid &&           // own doc only
            request.resource.data.submittedByUid == resource.data.submittedByUid // cannot change owner
          )
        );

      // DELETE
      allow delete: if isAdmin();
    }

    // ── Logs (append-only) ──────────────────────────────────
    match /logs/{logId} {
      allow read:           if isAdmin() || (isActive() && isVP());
      allow create:         if isAuthenticated() && isActive();
      allow update, delete: if false;
    }
  }
}
