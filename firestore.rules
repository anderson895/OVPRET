rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────
    function isAuthenticated() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function getUserRole() { return userDoc().role; }
    function isAdmin() { return isAuthenticated() && getUserRole() == 'admin'; }
    function isVP()    { return isAuthenticated() && getUserRole() == 'vp'; }
    function isStaff() { return isAuthenticated() && getUserRole() == 'staff'; }
    function isActive() { return userDoc().isActive == true; }

    // ── Users collection (staff profiles) ──────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ── Documents collection ────────────────────────────────
    match /documents/{docId} {
      // get (single doc) — staff can only read their own doc
      allow get: if isAdmin() ||
        (isAuthenticated() && isActive() && isVP()) ||
        (isAuthenticated() && isActive() && isStaff() && resource.data.submittedByUid == request.auth.uid);

      // list (queries/onSnapshot) — staff is allowed; query-level filter
      // (where submittedByUid == uid) is enforced in the app code
      allow list: if isAdmin() ||
        (isAuthenticated() && isActive() && isVP()) ||
        (isAuthenticated() && isActive() && isStaff());

      allow create: if isAuthenticated() && isActive() &&
        (isStaff() || isAdmin()) &&
        request.resource.data.submittedByUid == request.auth.uid;

      allow update: if isAuthenticated() && isActive() && (isVP() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Transaction logs — append-only ──────────────────────
    match /logs/{logId} {
      allow read:   if isAdmin() || (isAuthenticated() && isActive() && isVP());
      allow create: if isAuthenticated() && isActive();
      allow update, delete: if false;
    }
  }
}
