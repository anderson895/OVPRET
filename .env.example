# ============================================================
# FIREBASE CONFIGURATION
# Get from: Firebase Console > Project Settings > Web App
# ============================================================
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================
# CLOUDINARY CONFIGURATION
# Get from: cloudinary.com > Settings > Upload Presets
# ============================================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ============================================================
# BREVO (Sendinblue) EMAIL CONFIGURATION
# Get API key from: app.brevo.com > Settings > API Keys
# IMPORTANT: This key is exposed on the client.
# For production, route through a Cloud Function or backend.
# ============================================================
VITE_BREVO_API_KEY=your_brevo_api_key
VITE_BREVO_SENDER_EMAIL=noreply@yourdomain.com
VITE_BREVO_SENDER_NAME=OVPRET Document System

# VP email — receives notifications when documents are submitted
VITE_VP_EMAIL=vp@ovpret.edu.ph
VITE_VP_NAME=OVPRET Vice President

